{
  "id": "demo-plugin",
  "version": "1.0.0",
  "name": "示例插件",
  "author": "NexusAdmin",
  "mainClass": "com.nexusadmin.plugin.demo.DemoPlugin",
  "description": "用于演示插件系统核心功能的示例插件",
  "contributes": {
    "menus": [
      {
        "id": "demo-menu",
        "label": "示例功能",
        "icon": "flask",
        "order": 100,
        "route": "/demo",
        "permissions": ["demo.view"]
      }
    ],
    "routes": [
      {
        "path": "/demo",
        "component": "demo-plugin/pages/Index",
        "title": "示例页面",
        "icon": "flask",
        "permissions": ["demo.view"]
      }
    ],
    "permissions": [
      {
        "id": "demo.view",
        "label": "查看示例",
        "description": "查看示例插件页面"
      }
    ]
  }
}
