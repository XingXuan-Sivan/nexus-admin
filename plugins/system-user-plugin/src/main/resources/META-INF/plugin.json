{
  "id": "system-user-plugin",
  "version": "1.0.0",
  "name": "用户管理插件",
  "author": "NexusAdmin",
  "mainClass": "com.nexusadmin.plugin.system.user.SystemUserPlugin",
  "description": "提供用户管理、角色管理及权限分配功能",
  "contributes": {
    "menus": [
      {
        "id": "user-management",
        "label": "用户管理",
        "icon": "team",
        "order": 10
      },
      {
        "id": "user-list",
        "label": "用户列表",
        "icon": "user",
        "parentId": "user-management",
        "order": 1,
        "route": "/users"
      },
      {
        "id": "role-list",
        "label": "角色管理",
        "icon": "shield-check",
        "parentId": "user-management",
        "order": 2,
        "route": "/roles"
      }
    ],
    "routes": [
      {
        "path": "/users",
        "component": "system-user-plugin/pages/UserList",
        "title": "用户列表",
        "icon": "user",
        "permissions": ["users.view"]
      },
      {
        "path": "/roles",
        "component": "system-user-plugin/pages/RoleList",
        "title": "角色管理",
        "icon": "shield-check",
        "permissions": ["roles.view"]
      }
    ],
    "permissions": [
      {
        "id": "users.view",
        "label": "查看用户",
        "description": "查看用户列表和详情"
      },
      {
        "id": "users.manage",
        "label": "管理用户",
        "description": "创建、编辑、删除用户"
      },
      {
        "id": "roles.view",
        "label": "查看角色",
        "description": "查看角色列表"
      },
      {
        "id": "roles.manage",
        "label": "管理角色",
        "description": "创建、编辑、删除角色"
      }
    ]
  }
}
